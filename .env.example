# Frontend Environment Variables
# Copy this file to .env and update the values for your environment

# Backend API URL
# For development: http://localhost:5000
VITE_BASE_URL=http://localhost:5000

# Canonical public site URL (blog canonical links, OG URLs, sitemap references; no trailing slash)
# For production: https://sosapient.in
VITE_SITE_URL=https://sosapient.in

# Google Analytics 4 Measurement ID (page views + form_submit events)
# Falls back to the ID already in index.html when unset
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google reCAPTCHA v2 (public site key ONLY — never put the secret in the frontend).
# The matching secret lives on the backend as RECAPTCHA_SECRET_KEY.
# Local dev can use Google's official test key below (always passes):
#   site:   6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   secret: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
